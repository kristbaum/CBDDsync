#!/bin/sh
# Runs `wikibase-ingest` (https://gitlab.wikimedia.org/kristbaum/wikibase-ingest),
# which does every generic step (candidates, verify, triage, preflight,
# decide, next, resolve, como, report). This skill is an adapter
# (agentic-reconcile/adapter.toml) and ships no copy of it:
#
#   agentic-reconcile/scripts/wikibase-ingest --help
#
# Runs, in order of preference:
#   1. $WIKIBASE_INGEST, a wikibase-ingest executable;
#   2. the wikibase-ingest checkout next to the CBDDsync repository
#      (../wikibase-ingest), with its own launcher.
set -e
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -n "$WIKIBASE_INGEST" ]; then
    exec "$WIKIBASE_INGEST" "$@"
fi

launcher="$here/../../../wikibase-ingest/skill/scripts/wikibase-ingest"
if [ -x "$launcher" ]; then
    exec "$launcher" "$@"
fi

cat >&2 <<'MSG'
wikibase-ingest not found. Clone
https://gitlab.wikimedia.org/kristbaum/wikibase-ingest next to the CBDDsync
repository (../wikibase-ingest), or set WIKIBASE_INGEST to a wikibase-ingest
executable.
MSG
exit 2
